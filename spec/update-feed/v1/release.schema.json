{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Julesc013/compact-cassette-catalogue/spec/update-feed/v1/release.schema.json",
  "title": "C3 update release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "productId",
    "channel",
    "version",
    "stage",
    "informationalVersion",
    "releaseDate",
    "catalogueWriteFormat",
    "published",
    "releaseUrl",
    "checksumManifest",
    "packages"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "Compact Cassette Catalogue" },
    "productId": { "const": "c3" },
    "channel": { "enum": ["alpha", "beta", "stable"] },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "stage": {
      "type": "string",
      "pattern": "^(?:Alpha [1-9][0-9]*|Beta [1-9][0-9]*|Release Candidate [1-9][0-9]*|Release)$"
    },
    "informationalVersion": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:alpha|beta|rc)\\.[1-9][0-9]*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "releaseDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "catalogueWriteFormat": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "published": { "type": "boolean" },
    "releaseUrl": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "checksumManifest": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/checksumManifest" }
      ]
    },
    "packages": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "channel": { "const": "alpha" } },
        "required": ["channel"]
      },
      "then": {
        "properties": { "published": { "const": false } }
      }
    },
    {
      "if": {
        "properties": { "published": { "const": false } },
        "required": ["published"]
      },
      "then": {
        "properties": {
          "releaseUrl": { "type": "null" },
          "checksumManifest": { "type": "null" },
          "packages": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "published": { "const": true } },
        "required": ["published"]
      },
      "then": {
        "properties": {
          "releaseUrl": {
            "type": "string",
            "pattern": "^https://github\\.com/Julesc013/compact-cassette-catalogue/releases/tag/v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:alpha|beta|rc)\\.[1-9][0-9]*)?$"
          },
          "checksumManifest": { "$ref": "#/$defs/checksumManifest" },
          "packages": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "checksumManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "length", "sha256", "url"],
      "properties": {
        "file": { "const": "SHA256SUMS.txt" },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/Julesc013/compact-cassette-catalogue/releases/download/v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:alpha|beta|rc)\\.[1-9][0-9]*)?/SHA256SUMS\\.txt$"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "distribution", "file", "length", "sha256", "url"],
      "properties": {
        "lane": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "distribution": { "const": "portable" },
        "file": {
          "type": "string",
          "pattern": "^C3-v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:alpha|beta|rc)\\.[1-9][0-9]*)?-[a-z0-9][a-z0-9.-]*-portable\\.zip$"
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/Julesc013/compact-cassette-catalogue/releases/download/v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:alpha|beta|rc)\\.[1-9][0-9]*)?/C3-v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:alpha|beta|rc)\\.[1-9][0-9]*)?-[a-z0-9][a-z0-9.-]*-portable\\.zip$"
        }
      }
    }
  }
}

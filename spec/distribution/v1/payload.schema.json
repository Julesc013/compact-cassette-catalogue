{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Julesc013/compact-cassette-catalogue/spec/distribution/v1/payload.schema.json",
  "title": "C3 canonical portable payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "product", "entries"],
  "properties": {
    "$schema": { "const": "../../spec/distribution/v1/payload.schema.json" },
    "schemaVersion": { "const": 1 },
    "id": { "const": "c3-desktop-portable-payload-v1" },
    "product": { "const": "c3" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "sourceRoot", "source", "target"],
        "properties": {
          "role": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "sourceRoot": { "enum": ["lane-output", "cli-output", "repository", "generated"] },
          "source": { "type": "string", "minLength": 1, "maxLength": 256 },
          "target": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*$", "maxLength": 128 }
        }
      }
    }
  }
}

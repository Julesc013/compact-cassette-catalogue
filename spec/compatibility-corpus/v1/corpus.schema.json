{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Julesc013/compact-cassette-catalogue/spec/compatibility-corpus/v1/corpus.schema.json",
  "title": "C3 compatibility corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "capturedAt",
    "supportPolicy",
    "settingsProfiles",
    "updateProfiles",
    "formatProvenance",
    "releases"
  ],
  "properties": {
    "$schema": { "const": "../../../spec/compatibility-corpus/v1/corpus.schema.json" },
    "schemaVersion": { "const": 1 },
    "capturedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "supportPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productLine", "catalogueFormat", "supportedProducerTags", "inventoryOnlyProducerTags"],
      "properties": {
        "productLine": { "const": "C3 1.x" },
        "catalogueFormat": { "const": "1.1.0" },
        "supportedProducerTags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^v1\\.[0-9]+\\.[0-9]+(?:b[0-9]+)?$" }
        },
        "inventoryOnlyProducerTags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^v1\\.[0-9]+\\.[0-9]+b[0-9]+$" }
        }
      }
    },
    "settingsProfiles": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/settingsProfile" }
    },
    "updateProfiles": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/namedProfile" }
    },
    "formatProvenance": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/formatEvidence" }
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/release" }
    }
  },
  "$defs": {
    "namedProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "settingsProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "fixtures"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/settingsFixture" }
        }
      }
    },
    "settingsFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^fixtures/settings/legacy/v1\\.[a-zA-Z0-9.-]+/user\\.config$" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size", "sha256", "url", "architecture"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "url": { "type": "string", "format": "uri", "maxLength": 500 },
        "architecture": { "enum": ["anycpu", "x86", "x64"] }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256", "normalization"],
      "properties": {
        "path": { "type": "string", "pattern": "^fixtures/catalogues/v1\\.1\\.0/historical/[a-z0-9.-]+/blank\\.xml$" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "normalization": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "formatEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "producerVersion", "artifactName", "artifactSha256", "releaseTag", "classification"],
      "properties": {
        "format": { "enum": ["1.0.0", "1.0.1", "1.0.2", "1.1.0"] },
        "producerVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "artifactName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "releaseTag": { "const": "v0.5.4" },
        "classification": { "enum": ["archival-pre-1x", "supported-1x"] }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "sourceCommit",
        "publishedAt",
        "releaseUrl",
        "prerelease",
        "support",
        "reportedProductVersion",
        "reportedStage",
        "catalogueFormat",
        "targetFramework",
        "platforms",
        "settingsProfile",
        "updateProfile",
        "artifacts",
        "fixtures",
        "deviations"
      ],
      "properties": {
        "tag": { "type": "string", "pattern": "^v1\\.[0-9]+\\.[0-9]+(?:b[0-9]+)?$" },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "publishedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "releaseUrl": { "type": "string", "format": "uri", "maxLength": 500 },
        "prerelease": { "type": "boolean" },
        "support": { "enum": ["supported", "inventory-only"] },
        "reportedProductVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
        "reportedStage": { "type": "string", "minLength": 1, "maxLength": 40 },
        "catalogueFormat": { "const": "1.1.0" },
        "targetFramework": { "enum": ["net46", "net40"] },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["anycpu", "x86", "x64"] }
        },
        "settingsProfile": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "updateProfile": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "fixtures": {
          "type": "array",
          "items": { "$ref": "#/$defs/fixture" }
        },
        "deviations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}

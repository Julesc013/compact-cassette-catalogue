<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Current build identity. Published update feeds are promoted separately. -->
  <PropertyGroup>
    <C3ProductVersion>2.0.0</C3ProductVersion>
    <C3ReleaseStage>Alpha 2</C3ReleaseStage>
    <C3ReleaseChannel>alpha</C3ReleaseChannel>
    <C3UpdateFeedUrl>https://raw.githubusercontent.com/Julesc013/compact-cassette-catalogue/dev/2.x/release/feeds/alpha/release.json</C3UpdateFeedUrl>
    <C3ReleaseDate>2026-08-04</C3ReleaseDate>
    <C3AssemblyVersion>2.0.0.0</C3AssemblyVersion>
    <C3FileVersion>2.0.0.2</C3FileVersion>
    <C3LegacyCatalogueFormatVersion>1.1.0</C3LegacyCatalogueFormatVersion>
  </PropertyGroup>
</Project>

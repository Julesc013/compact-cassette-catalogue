# Auto detect text files and perform LF normalization
* text=auto

# Bytes embedded in portable packages are canonical LF text in every checkout.
README.md text eol=lf
RELEASE_NOTES.md text eol=lf

# JSON is a machine-owned interoperability surface. Keep its checked-out bytes
# identical on Windows and non-Windows runners so deterministic generators can
# compare their projections directly with the committed repository state.
*.json text eol=lf
*.toml text eol=lf

# Hash-pinned compatibility fixtures require checkout-stable bytes. Historical
# catalogue fixtures use repository-canonical LF; captured .NET user.config
# profiles retain their original Windows CRLF transport.
fixtures/catalogues/v1.1.0/historical/** text eol=lf
fixtures/settings/legacy/**/user.config text eol=crlf
